# Variables de Configuración para el Servidor de Correo y Webmail

# Configuraciones Globales
DOMAINNAME=reprobados.com
HOSTNAME=mail
TZ=America/Mexico_City

# Base de datos de Roundcube
MYSQL_ROOT_PASSWORD=S3cr3tRootPassword!
MYSQL_DATABASE=roundcubemail
MYSQL_USER=roundcube
MYSQL_PASSWORD=S3cr3tRoundcubePassword!

# Configuración de Roundcube
# Forzamos conexión al contenedor de correo (resolución de nombre de Docker)
ROUNDCUBEMAIL_DEFAULT_HOST=tls://mailserver
ROUNDCUBEMAIL_SMTP_SERVER=tls://mailserver
ROUNDCUBEMAIL_DEFAULT_PORT=143
ROUNDCUBEMAIL_SMTP_PORT=587
ROUNDCUBEMAIL_DB_TYPE=mysql
ROUNDCUBEMAIL_SKIN=elastic
